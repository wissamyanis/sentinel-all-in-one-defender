{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaceName": {
            "type": "string",
            "metadata": { "description": "Log Analytics / Sentinel workspace name." }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]"
        },
        "severityLevels": {
            "type": "array",
            "defaultValue": [ "High", "Medium" ],
            "metadata": { "description": "Severities to enable." }
        },
        "deploymentConnectors": {
            "type": "array",
            "defaultValue": [],
            "metadata": { "description": "Connectors selected in the wizard; rules are gated to these." }
        },
        "scriptUri": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/wissamyanis/sentinel-all-in-one-defender/main/Scripts/EnableRules.ps1",
            "metadata": { "description": "URI of EnableRules.ps1 to run." }
        },
        "roleGuid": {
            "type": "string",
            "defaultValue": "[newGuid()]"
        }
    },
    "variables": {
        "identityName": "[concat('uami-enablerules-', uniqueString(resourceGroup().id))]",
        "sentinelContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ab8e14d6-4a74-4a29-9ba8-549422addade')]",
        "severitiesArg": "[replace(replace(replace(string(parameters('severityLevels')),'\"',''),'[',''),']','')]",
        "connectorsArg": "[replace(replace(replace(string(parameters('deploymentConnectors')),'\"',''),'[',''),']','')]"
    },
    "resources": [
        {
            "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
            "name": "[variables('identityName')]",
            "apiVersion": "2023-01-31",
            "location": "[parameters('location')]"
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[parameters('roleGuid')]",
            "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('sentinelContributorRoleId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31', 'Full').properties.principalId]",
                "principalType": "ServicePrincipal",
                "scope": "[resourceGroup().id]"
            }
        },
        {
            "type": "Microsoft.Resources/deploymentScripts",
            "apiVersion": "2020-10-01",
            "name": "autoEnableRules",
            "location": "[parameters('location')]",
            "kind": "AzurePowerShell",
            "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleAssignments', parameters('roleGuid'))]"
            ],
            "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                    "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
                }
            },
            "properties": {
                "forceUpdateTag": "[parameters('roleGuid')]",
                "azPowerShellVersion": "11.0",
                "timeout": "PT45M",
                "retentionInterval": "P1D",
                "cleanupPreference": "OnSuccess",
                "primaryScriptUri": "[parameters('scriptUri')]",
                "arguments": "[concat('-ResourceGroup ', resourceGroup().name, ' -Workspace ', parameters('workspaceName'), ' -SeveritiesToInclude ', variables('severitiesArg'), ' -DeploymentConnectors ', variables('connectorsArg'))]"
            }
        }
    ],
    "outputs": {}
}
