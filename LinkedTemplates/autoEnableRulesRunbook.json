{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaceName": {
            "type": "string",
            "metadata": { "description": "Log Analytics / Sentinel workspace name." }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]"
        },
        "severityLevels": {
            "type": "array",
            "defaultValue": [ "High", "Medium" ]
        },
        "deploymentConnectors": {
            "type": "array",
            "defaultValue": []
        },
        "runbookUri": {
            "type": "string",
            "defaultValue": "https://raw.githubusercontent.com/wissamyanis/sentinel-all-in-one-defender/main/Scripts/EnableRulesRunbook.ps1",
            "metadata": { "description": "URI of the runbook PowerShell script." }
        },
        "roleGuid": {
            "type": "string",
            "defaultValue": "[newGuid()]"
        },
        "jobGuid": {
            "type": "string",
            "defaultValue": "[newGuid()]"
        }
    },
    "variables": {
        "automationAccountName": "[concat('aa-enablerules-', uniqueString(resourceGroup().id, parameters('workspaceName')))]",
        "runbookName": "EnableSentinelRules",
        "sentinelContributorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ab8e14d6-4a74-4a29-9ba8-549422addade')]",
        "severitiesArg": "[replace(replace(replace(string(parameters('severityLevels')),'\"',''),'[',''),']','')]",
        "connectorsArg": "[replace(replace(replace(string(parameters('deploymentConnectors')),'\"',''),'[',''),']','')]"
    },
    "resources": [
        {
            "type": "Microsoft.Automation/automationAccounts",
            "apiVersion": "2023-11-01",
            "name": "[variables('automationAccountName')]",
            "location": "[parameters('location')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "sku": { "name": "Basic" },
                "publicNetworkAccess": true
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/runbooks",
            "apiVersion": "2023-11-01",
            "name": "[concat(variables('automationAccountName'), '/', variables('runbookName'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]"
            ],
            "properties": {
                "runbookType": "PowerShell",
                "logProgress": true,
                "logVerbose": false,
                "publishContentLink": {
                    "uri": "[parameters('runbookUri')]",
                    "version": "1.0.0.0"
                }
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[parameters('roleGuid')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[variables('sentinelContributorRoleId')]",
                "principalId": "[reference(resourceId('Microsoft.Automation/automationAccounts', variables('automationAccountName')), '2023-11-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal",
                "scope": "[resourceGroup().id]"
            }
        },
        {
            "type": "Microsoft.Automation/automationAccounts/jobs",
            "apiVersion": "2019-06-01",
            "name": "[concat(variables('automationAccountName'), '/', parameters('jobGuid'))]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Automation/automationAccounts/runbooks', variables('automationAccountName'), variables('runbookName'))]",
                "[resourceId('Microsoft.Authorization/roleAssignments', parameters('roleGuid'))]"
            ],
            "properties": {
                "runbook": {
                    "name": "[variables('runbookName')]"
                },
                "parameters": {
                    "SubscriptionId": "[subscription().subscriptionId]",
                    "ResourceGroup": "[resourceGroup().name]",
                    "Workspace": "[parameters('workspaceName')]",
                    "Severities": "[variables('severitiesArg')]",
                    "DeploymentConnectors": "[variables('connectorsArg')]"
                }
            }
        }
    ],
    "outputs": {
        "automationAccountName": {
            "type": "string",
            "value": "[variables('automationAccountName')]"
        }
    }
}
