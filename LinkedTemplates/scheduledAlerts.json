{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name for the Log Analytics workspace"
            }
        },
        "dataConnectorsKind": {
            "type": "array",
            "defaultValue": [],
            "metadata": {
                "description": "The kind of data connectors enabled; used to gate connector-specific rules."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources."
            }
        },
        "ruleGuid": {
            "type": "string",
            "defaultValue": "[newGuid()]",
            "metadata": {
                "description": "Seed for unique rule names."
            }
        },
        "severityLevels": {
            "type": "array",
            "defaultValue": [ "High", "Medium", "Low", "Informational" ],
            "metadata": {
                "description": "Severities to deploy for the scheduled KQL rules. A scheduled rule is only created when its severity is in this list."
            }
        }
    },
    "variables": {
        "aatpRuleId": "[concat('aatpRuleId', uniqueString(parameters('ruleGuid')))]",
        "ascRuleId": "[concat('ascRuleId', uniqueString(parameters('ruleGuid')))]",
        "mcasRuleId": "[concat('mcasRuleId', uniqueString(parameters('ruleGuid')))]",
        "iotRuleId": "[concat('iotRuleId', uniqueString(parameters('ruleGuid')))]",
        "schedFailedSignins": "[concat('schedFailedSignins', uniqueString(parameters('ruleGuid')))]",
        "schedPrivRole": "[concat('schedPrivRole', uniqueString(parameters('ruleGuid')))]",
        "schedAppCred": "[concat('schedAppCred', uniqueString(parameters('ruleGuid')))]"
    },
    "resources": [
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'AzureAdvancedThreatProtection')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('aatpRuleId'))]",
            "apiVersion": "2023-02-01",
            "kind": "MicrosoftSecurityIncidentCreation",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "Create incidents based on Microsoft Defender for Identity alerts",
                "description": "Create incidents based on all alerts generated in Microsoft Defender for Identity",
                "enabled": true,
                "productFilter": "Azure Advanced Threat Protection"
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftDefenderForCloud')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('ascRuleId'))]",
            "apiVersion": "2023-02-01",
            "kind": "MicrosoftSecurityIncidentCreation",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "Create incidents based on Microsoft Defender for Cloud alerts",
                "description": "Create incidents based on all alerts generated in Microsoft Defender for Cloud",
                "enabled": true,
                "productFilter": "Azure Security Center"
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftCloudAppSecurity')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('mcasRuleId'))]",
            "apiVersion": "2023-02-01",
            "kind": "MicrosoftSecurityIncidentCreation",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "Create incidents based on Microsoft Defender for Cloud Apps alerts",
                "description": "Create incidents based on all alerts generated in Microsoft Defender for Cloud Apps",
                "enabled": true,
                "productFilter": "Microsoft Cloud App Security"
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'IOT')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('iotRuleId'))]",
            "apiVersion": "2023-02-01",
            "kind": "MicrosoftSecurityIncidentCreation",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "Create incidents based on Microsoft Defender for IoT alerts",
                "description": "Create incidents based on all alerts generated in Microsoft Defender for IoT",
                "enabled": true,
                "productFilter": "Azure Security Center for IoT"
            }
        },
        {
            "condition": "[and(contains(parameters('dataConnectorsKind'), 'AzureActiveDirectory'), contains(parameters('severityLevels'), 'Medium'))]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('schedFailedSignins'))]",
            "apiVersion": "2023-02-01",
            "kind": "Scheduled",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "Multiple failed Entra ID sign-ins from a single user",
                "description": "Detects a user account with a high number of failed Entra ID sign-in attempts within the lookback window, indicating password guessing or brute force.",
                "severity": "Medium",
                "enabled": true,
                "query": "SigninLogs\n| where ResultType in (\"50126\", \"50053\", \"50055\", \"50056\", \"50057\", \"50072\", \"50074\")\n| summarize FailedCount = count(), IPAddresses = make_set(IPAddress, 20), StartTime = min(TimeGenerated), EndTime = max(TimeGenerated) by UserPrincipalName, UserId\n| where FailedCount >= 10\n| extend AccountName = tostring(split(UserPrincipalName, \"@\")[0]), UPNSuffix = tostring(split(UserPrincipalName, \"@\")[1])",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "tactics": [
                    "CredentialAccess"
                ],
                "techniques": [
                    "T1110"
                ],
                "entityMappings": [
                    {
                        "entityType": "Account",
                        "fieldMappings": [
                            {
                                "identifier": "FullName",
                                "columnName": "UserPrincipalName"
                            },
                            {
                                "identifier": "Name",
                                "columnName": "AccountName"
                            },
                            {
                                "identifier": "UPNSuffix",
                                "columnName": "UPNSuffix"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "condition": "[and(contains(parameters('dataConnectorsKind'), 'AzureActiveDirectory'), contains(parameters('severityLevels'), 'High'))]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('schedPrivRole'))]",
            "apiVersion": "2023-02-01",
            "kind": "Scheduled",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "User added to Entra ID privileged role",
                "description": "Detects when an account is added as a member to an Entra ID directory role (potential privilege escalation / persistence).",
                "severity": "High",
                "enabled": true,
                "query": "AuditLogs\n| where OperationName =~ \"Add member to role\"\n| where Result =~ \"success\"\n| extend TargetUPN = tostring(TargetResources[0].userPrincipalName)\n| extend Initiator = tostring(iff(isnotempty(InitiatedBy.user.userPrincipalName), InitiatedBy.user.userPrincipalName, InitiatedBy.app.displayName))\n| extend InitiatorIp = tostring(InitiatedBy.user.ipAddress)\n| project TimeGenerated, OperationName, TargetUPN, Initiator, InitiatorIp, Result\n| extend AccountName = tostring(split(TargetUPN, \"@\")[0]), UPNSuffix = tostring(split(TargetUPN, \"@\")[1])",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "tactics": [
                    "Persistence",
                    "PrivilegeEscalation"
                ],
                "techniques": [
                    "T1098"
                ],
                "entityMappings": [
                    {
                        "entityType": "Account",
                        "fieldMappings": [
                            {
                                "identifier": "FullName",
                                "columnName": "TargetUPN"
                            },
                            {
                                "identifier": "Name",
                                "columnName": "AccountName"
                            },
                            {
                                "identifier": "UPNSuffix",
                                "columnName": "UPNSuffix"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "condition": "[and(contains(parameters('dataConnectorsKind'), 'AzureActiveDirectory'), contains(parameters('severityLevels'), 'High'))]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('schedAppCred'))]",
            "apiVersion": "2023-02-01",
            "kind": "Scheduled",
            "location": "[parameters('location')]",
            "properties": {
                "displayName": "New credential added to an Entra ID application or service principal",
                "description": "Alerts when a new credential (certificate or secret) is added to an application or service principal, which a threat actor can use to authenticate as that identity.",
                "severity": "High",
                "enabled": true,
                "query": "AuditLogs\n| where OperationName has \"Certificates and secrets management\" or OperationName has_any (\"Add service principal credentials\", \"Update application - Certificates and secrets management\")\n| where Result =~ \"success\"\n| extend TargetApp = tostring(TargetResources[0].displayName)\n| extend Initiator = tostring(iff(isnotempty(InitiatedBy.user.userPrincipalName), InitiatedBy.user.userPrincipalName, InitiatedBy.app.displayName))\n| extend InitiatorIp = tostring(iff(isnotempty(InitiatedBy.user.ipAddress), InitiatedBy.user.ipAddress, InitiatedBy.app.ipAddress))\n| project TimeGenerated, OperationName, TargetApp, Initiator, InitiatorIp, Result\n| extend AccountName = tostring(split(Initiator, \"@\")[0]), UPNSuffix = tostring(split(Initiator, \"@\")[1])",
                "queryFrequency": "PT1H",
                "queryPeriod": "PT1H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "tactics": [
                    "DefenseEvasion",
                    "Persistence"
                ],
                "techniques": [
                    "T1098"
                ],
                "entityMappings": [
                    {
                        "entityType": "Account",
                        "fieldMappings": [
                            {
                                "identifier": "FullName",
                                "columnName": "Initiator"
                            },
                            {
                                "identifier": "Name",
                                "columnName": "AccountName"
                            },
                            {
                                "identifier": "UPNSuffix",
                                "columnName": "UPNSuffix"
                            }
                        ]
                    },
                    {
                        "entityType": "CloudApplication",
                        "fieldMappings": [
                            {
                                "identifier": "Name",
                                "columnName": "TargetApp"
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "outputs": {}
}
