{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "dataConnectorsKind": {
            "type": "array",
            "defaultValue": [],
            "metadata": {
                "description": "The kind of data connectors to enable"
            }
        },
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Name for the Log Analytics workspace used to aggregate data"
            }
        },
        "tenantId": {
            "type": "string",
            "metadata": {
                "description": "Azure AD tenant ID"
            }
        },
        "subscriptionId": {
            "type": "string",
            "metadata": {
                "description": "Sbscription Id to monitor"
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for all resources."
            }
        }
    },
    "variables": {
        "o365Name": "[concat('o365', uniqueString(resourceGroup().id))]",
        "m365dName": "[concat('m365d', uniqueString(resourceGroup().id))]",
        "d365Name": "[concat('d365', uniqueString(resourceGroup().id))]",
        "iotName": "[concat('iot', uniqueString(resourceGroup().id))]",
        "projectName": "[concat('project', uniqueString(resourceGroup().id))]",
        "irmName": "[concat('irm', uniqueString(resourceGroup().id))]",
        "powerbiName": "[concat('powerbi', uniqueString(resourceGroup().id))]",
        "ascName": "[concat('asc', uniqueString(resourceGroup().id))]",
        "tiName": "[concat('ti', uniqueString(resourceGroup().id))]",
        "mstiName": "[concat('msti', uniqueString(resourceGroup().id))]",
        "premiumMdtiName": "[concat('premiumMdti', uniqueString(resourceGroup().id))]",
        "mcasName": "[concat('mcas', uniqueString(resourceGroup().id))]",
        "aatpName": "[concat('aatp', uniqueString(resourceGroup().id))]",
        "mdatpName": "[concat('mdatp', uniqueString(resourceGroup().id))]"
    },
    "resources": [
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'Office365')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('o365Name'))]",
            "kind": "Office365",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "exchange": {
                        "state": "enabled"
                    },
                    "sharePoint": {
                        "state": "enabled"
                    },
                    "teams": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftDefenderForCloud')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('ascName'))]",
            "kind": "AzureSecurityCenter",
            "properties": {
                "subscriptionId": "[parameters('subscriptionId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'Microsoft365Defender')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('m365dName'))]",
            "kind": "MicrosoftThreatProtection",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "incidents": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'Dynamics365')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('d365Name'))]",
            "kind": "Dynamics365",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "dynamics365CdsActivities": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'IOT')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('iotName'))]",
            "kind": "IOT",
            "properties": {
                "subscriptionId": "[parameters('subscriptionId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'Office365Project')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('projectName'))]",
            "kind": "Office365Project",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "logs": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'OfficeIRM')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('irmName'))]",
            "kind": "OfficeIRM",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'PowerBI')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2022-12-01-preview",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('powerbiName'))]",
            "kind": "OfficePowerBI",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "logs": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'ThreatIntelligence')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('tiName'))]",
            "kind": "ThreatIntelligence",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "indicators": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftThreatIntelligence')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('mstiName'))]",
            "kind": "MicrosoftThreatIntelligence",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "microsoftEmergingThreatFeed": {
                        "lookbackPeriod": "1970-01-01T00:00:00.000Z",
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'PremiumMicrosoftDefenderForThreatIntelligence')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('premiumMdtiName'))]",
            "kind": "PremiumMicrosoftDefenderForThreatIntelligence",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "lookbackPeriod": "1970-01-01T00:00:00.000Z",
                "dataTypes": {
                    "connector": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftCloudAppSecurity')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('mcasName'))]",
            "kind": "MicrosoftCloudAppSecurity",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    },
                    "discoveryLogs": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'AzureAdvancedThreatProtection')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('aatpName'))]",
            "kind": "AzureAdvancedThreatProtection",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'MicrosoftDefenderAdvancedThreatProtection')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/dataConnectors",
            "apiVersion": "2025-09-01",
            "location": "[parameters('location')]",
            "name": "[concat(parameters('workspaceName'),'/Microsoft.SecurityInsights/',variables('mdatpName'))]",
            "kind": "MicrosoftDefenderAdvancedThreatProtection",
            "properties": {
                "tenantId": "[parameters('tenantId')]",
                "dataTypes": {
                    "alerts": {
                        "state": "enabled"
                    }
                }
            }
        }
    ]
}
