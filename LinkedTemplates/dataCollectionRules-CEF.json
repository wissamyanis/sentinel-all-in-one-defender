{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "dataConnectorsKind": {
            "type": "array",
            "defaultValue": [],
            "metadata": {
                "description": "Acts when it contains 'CEFViaAMA' and/or 'SyslogViaAMA'."
            }
        },
        "workspaceName": {
            "type": "string",
            "metadata": {
                "description": "Log Analytics workspace that receives the CEF/Syslog data."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "Location for the Data Collection Rules."
            }
        }
    },
    "variables": {
        "cefDcrName": "[concat('DCR-CEF-', uniqueString(resourceGroup().id))]",
        "syslogDcrName": "[concat('DCR-Syslog-', uniqueString(resourceGroup().id))]"
    },
    "resources": [
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'CEFViaAMA')]",
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2024-03-11",
            "name": "[variables('cefDcrName')]",
            "location": "[parameters('location')]",
            "kind": "Linux",
            "properties": {
                "description": "Microsoft-CommonSecurityLog via AMA - deployed by Sentinel Accelerated All-in-One.",
                "dataSources": {
                    "syslog": [
                        {
                            "name": "sysLogsDataSource",
                            "streams": [
                                "Microsoft-CommonSecurityLog"
                            ],
                            "facilityNames": [
                                "auth",
                                "authpriv",
                                "cron",
                                "daemon",
                                "kern",
                                "lpr",
                                "mail",
                                "news",
                                "syslog",
                                "user",
                                "uucp",
                                "ftp",
                                "local0",
                                "local1",
                                "local2",
                                "local3",
                                "local4",
                                "local5",
                                "local6",
                                "local7"
                            ],
                            "logLevels": [
                                "Debug",
                                "Info",
                                "Notice",
                                "Warning",
                                "Error",
                                "Critical",
                                "Alert",
                                "Emergency"
                            ]
                        }
                    ]
                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "name": "DataCollectionEvent",
                            "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "Microsoft-CommonSecurityLog"
                        ],
                        "destinations": [
                            "DataCollectionEvent"
                        ]
                    }
                ]
            }
        },
        {
            "condition": "[contains(parameters('dataConnectorsKind'), 'SyslogViaAMA')]",
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2024-03-11",
            "name": "[variables('syslogDcrName')]",
            "location": "[parameters('location')]",
            "kind": "Linux",
            "properties": {
                "description": "Microsoft-Syslog via AMA - deployed by Sentinel Accelerated All-in-One.",
                "dataSources": {
                    "syslog": [
                        {
                            "name": "sysLogsDataSource",
                            "streams": [
                                "Microsoft-Syslog"
                            ],
                            "facilityNames": [
                                "auth",
                                "authpriv",
                                "cron",
                                "daemon",
                                "kern",
                                "lpr",
                                "mail",
                                "news",
                                "syslog",
                                "user",
                                "uucp",
                                "ftp",
                                "local0",
                                "local1",
                                "local2",
                                "local3",
                                "local4",
                                "local5",
                                "local6",
                                "local7"
                            ],
                            "logLevels": [
                                "Debug",
                                "Info",
                                "Notice",
                                "Warning",
                                "Error",
                                "Critical",
                                "Alert",
                                "Emergency"
                            ]
                        }
                    ]
                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "name": "DataCollectionEvent",
                            "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "Microsoft-Syslog"
                        ],
                        "destinations": [
                            "DataCollectionEvent"
                        ]
                    }
                ]
            }
        }
    ]
}
